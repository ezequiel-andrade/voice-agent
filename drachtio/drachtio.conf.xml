<drachtio>
  <admin port="9022" secret="CaminhoDrachtio2024"/>
  <request-handler>
    <sip-dialog-controller>
      <max-dialogs>5000</max-dialogs>
    </sip-dialog-controller>
  </request-handler>
  <sip>
    <contacts>
      <contact>
        <uri>sip:*;transport=udp,tcp</uri>
        <external-ip>auto-detect</external-ip>
