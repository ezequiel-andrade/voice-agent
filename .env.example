# ── APIs ──────────────────────────────────────────────────────────────────────
DEEPGRAM_KEY=sua_chave_deepgram
INCEPTION_KEY=sua_chave_inception
RIME_KEY=sua_chave_rime

# ── IMPORTANTE: IP da sua máquina na rede local ───────────────────────────────
# Execute: hostname -I | awk '{print $1}'
# e cole o resultado aqui
HOST_IP=192.168.1.100

# ── Agente ────────────────────────────────────────────────────────────────────
AGENT_SPEAKER=astra
AGENT_MODEL=arcana
RATE_LIMIT=20

# language for the agent's responses (Deepgram will auto-detect the input language)
AGENT_LANG=eng
# AGENT_LANG=spa
# AGENT_LANG=fra
# AGENT_LANG=ger
# AGENT_LANG=por